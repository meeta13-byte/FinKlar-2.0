<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-to-device transfer rules for Android 12+ (API 31+).

   Replaces backup_rules.xml from API 31 onward. Same policy: exclude everything.
   The PIN verifier, database passphrase, API keys and encrypted user profile must
   never be transferred to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>