<?xml version="1.0" encoding="utf-8"?><!--
   Scoped to the transaction export directory only.

   The previous rules exposed the entire cache via path=".", which meant any URI
   generated by this FileProvider could resolve to unrelated cached content. Exports
   are written to cacheDir/export/ (see exportTransactions in Screens.kt), so that
   single subdirectory is all that needs to be shareable.
-->
<paths>
    <cache-path name="transaction_exports" path="export/" />
</paths>